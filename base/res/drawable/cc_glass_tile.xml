<?xml version="1.0" encoding="utf-8"?>
<selector android:enterFadeDuration="180" android:exitFadeDuration="180"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#ffffffff" />
            <corners android:radius="26.0dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:startColor="#8c48484c" android:endColor="#99242426" android:angle="270.0" />
                    <corners android:radius="26.0dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1.0dp" android:color="#38ffffff" />
                    <corners android:radius="26.0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
